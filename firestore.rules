rules_version = '2';

// Regras de segurança do Firestore
// - Clientes e agendamentos: SOMENTE leitura para administradores.
//   Toda gravação é feita pelo servidor (Vercel Functions com Firebase Admin), que ignora estas regras.
// - Administradores: doc em /admins/{email-em-minúsculas}
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailAtual() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(emailAtual()));
    }

    match /admins/{email} {
      allow read: if isAdmin() || (logado() && emailAtual() == email);
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    match /clientes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /agendamentos/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
