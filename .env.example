# ==========================================================
#  Variáveis de ambiente — configure na Vercel:
#  Project → Settings → Environment Variables
#  (para rodar local com `vercel dev`, copie para .env.local)
# ==========================================================

# JSON da conta de serviço do Google/Firebase (JSON puro OU codificado em base64)
# Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID da agenda do Google do salão (Google Agenda → Configurações da agenda → "ID da agenda")
# A agenda precisa estar compartilhada com o client_email da conta de serviço
# com permissão "Fazer alterações nos eventos". Deixe vazio para desativar a integração.
GOOGLE_CALENDAR_ID=

# E-mails com acesso ao painel /admin (separados por vírgula)
ADMIN_EMAILS=dono@salao.com.br

# SMTP para e-mail de confirmação (Gmail: use "Senha de app", não a senha normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=seuemail@gmail.com

# (opcional) recebe cópia oculta de cada confirmação
EMAIL_COPIA_SALAO=
