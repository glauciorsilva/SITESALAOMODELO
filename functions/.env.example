# ==========================================================
#  Copie para functions/.env e preencha (NÃO suba o .env para o GitHub)
#  A senha do e-mail NÃO fica aqui: é um segredo, configurado com
#    firebase functions:secrets:set SMTP_PASS
# ==========================================================

# E-mails com acesso ao painel /admin (separados por vírgula)
ADMIN_EMAILS=dono@salao.com.br

# ID da agenda do Google do salão (Google Agenda → Configurações da agenda → "ID da agenda")
# Deixe vazio para desativar a integração com o Calendar.
GOOGLE_CALENDAR_ID=

# SMTP para o e-mail de confirmação (Gmail: senha de app em SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_FROM=seuemail@gmail.com

# (opcional) recebe cópia oculta de cada confirmação
EMAIL_COPIA_SALAO=
